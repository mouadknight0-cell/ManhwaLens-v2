    <!-- Onboarding -->
    <string name="onboarding_title">Welcome to ManhwaLens</string>
    <string name="onboarding_subtitle">The lens that reads Korean, Japanese and Chinese manhwa and translates them for you — right over the page.</string>
    <string name="onboarding_step_capture_title">Screen capture</string>
    <string name="onboarding_step_capture_body">Android asks for one-time consent before any capture. Frames are processed on-device and never uploaded.</string>
    <string name="onboarding_step_bubble_title">Floating bubble</string>
    <string name="onboarding_step_bubble_body">A draggable lens sits above your reader app. Tap it to translate what is on screen.</string>
    <string name="onboarding_step_private_title">Private by design</string>
    <string name="onboarding_step_private_body">Screenshots are analyzed locally with ML Kit. History is stored only on this device and can be cleared anytime.</string>
