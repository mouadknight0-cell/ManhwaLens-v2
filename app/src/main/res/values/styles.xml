<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ManhwaLens" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0A1A</item>
        <item name="android:statusBarColor">#0D0A1A</item>
        <item name="android:navigationBarColor">#0D0A1A</item>
        <item name="android:colorPrimary">#8B5CF6</item>
        <item name="android:colorAccent">#F59E0B</item>
