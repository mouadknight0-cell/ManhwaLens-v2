# Gradle
.gradle/
build/
*/build/
!gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
.cxx/
.externalNativeBuild/
captures/
local.properties

# OS
.DS_Store
Thumbs.db

# Signing — never commit keys or their passwords
*.jks
*.keystore
*.p12
*.pfx
keystore.properties

# Release outputs
/app/release/
*.apk
*.aab

# Misc
node_modules/
*.log

# Local image-fixture preparation environment
.venv/

# Python audit tooling bytecode
__pycache__/
*.pyc

# Translation evaluation: device-produced outputs and review decisions are user
# data. They may contain captured dialogue and must never be committed.
evaluation/device/
evaluation/review/*.decisions.json
# The review sheet is generated on demand (`review-sheet`); keep it out of Git.
evaluation/review/review-sheet.html
evaluation/reports/evaluation-run.*
evaluation/reports/regression-review.*
